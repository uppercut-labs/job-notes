{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "job-notes",
  "account_id": "f81d8a09a3b225b740c17f5a39f6cf80",
  "compatibility_date": "2026-10-31",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "job-notes.uppercut-labs.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
